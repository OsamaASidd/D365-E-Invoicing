                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!IRN_QR_Code_URL.Value, "HeaderGroup")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>7.5pt</FontSize>
                                        <Color>#1B2C6B</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbDisclaimer">
                              <CanGrow>true</CanGrow>
                              <Top>2.8cm</Top>
                              <Left>0cm</Left>
                              <Width>15cm</Width>
                              <Height>0.8cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>This invoice has been submitted to the Nigeria Revenue Service (NRS) for e-invoicing compliance. The IRN and QR code can be used to verify this document.</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>7pt</FontSize>
                                        <Color>#888888</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <!-- QR Code image - right side -->
                            <Image Name="QRCodeImg">
                              <Source>Database</Source>
                              <Value>=First(Fields!IRN_QR_Image.Value, "HeaderGroup")</Value>
                              <MIMEType>image/png</MIMEType>
                              <Sizing>FitProportional</Sizing>
                              <Top>0.1cm</Top>
                              <Left>15.5cm</Left>
                              <Width>3.5cm</Width>
                              <Height>3.5cm</Height>
                            </Image>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember />
              </TablixMembers>
            </TablixColumnHierarchy>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <Group Name="HeaderGroup">
                    <GroupExpressions>
                      <GroupExpression>=Fields!No_.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <TablixMembers>
                    <TablixMember />
                    <TablixMember />
                    <TablixMember>
                      <KeepWithGroup>After</KeepWithGroup>
                    </TablixMember>
                    <TablixMember>
                      <Group Name="LineGroup" />
                    </TablixMember>
                    <TablixMember />
                    <TablixMember />
                    <TablixMember />
                    <TablixMember />
                    <TablixMember />
                  </TablixMembers>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
            <DataSetName>DataSet_Result</DataSetName>
            <Top>0cm</Top>
            <Left>0cm</Left>
            <Height>20cm</Height>
            <Width>19cm</Width>
          </Tablix>
        </ReportItems>
        <Height>29cm</Height>
      </Body>
      <Width>19cm</Width>
      <Page>
