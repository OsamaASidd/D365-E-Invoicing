                                        <Color>#222222</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbCurrencyLbl">
                              <CanGrow>false</CanGrow>
                              <Top>2.6cm</Top>
                              <Left>11.3cm</Left>
                              <Width>3.8cm</Width>
                              <Height>0.55cm</Height>
                              <Style>
