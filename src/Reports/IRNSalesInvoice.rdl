                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=IIF(First(Fields!Currency_Code.Value, "HeaderGroup") = "", "NGN", First(Fields!Currency_Code.Value, "HeaderGroup"))</Value>
