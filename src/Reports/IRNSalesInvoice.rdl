                              <CanGrow>true</CanGrow>
                              <Top>0.6cm</Top>
                              <Left>0cm</Left>
                              <Width>10.5cm</Width>
                              <Height>0.6cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!Sell_to_Customer_Name.Value, "HeaderGroup")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>10pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>#222222</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbCustAddr">
                              <CanGrow>true</CanGrow>
                              <Top>1.25cm</Top>
                              <Left>0cm</Left>
                              <Width>10.5cm</Width>
                              <Height>0.5cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!Sell_to_Address.Value, "HeaderGroup")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <Color>#444444</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbCustCity">
                              <CanGrow>true</CanGrow>
                              <Top>1.75cm</Top>
                              <Left>0cm</Left>
                              <Width>10.5cm</Width>
                              <Height>0.5cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!Sell_to_City.Value, "HeaderGroup") &amp; IIF(First(Fields!Sell_to_Post_Code.Value, "HeaderGroup") = "", "", ", " &amp; First(Fields!Sell_to_Post_Code.Value, "HeaderGroup"))</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <Color>#444444</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbCustCountry">
                              <CanGrow>true</CanGrow>
                              <Top>2.25cm</Top>
                              <Left>0cm</Left>
                              <Width>10.5cm</Width>
                              <Height>0.5cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!Sell_to_Country_Region_Code.Value, "HeaderGroup")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <Color>#444444</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <!-- Vertical divider line -->
                            <Rectangle Name="VertDiv">
                              <Top>0cm</Top>
                              <Left>11cm</Left>
                              <Width>0.05cm</Width>
                              <Height>3.8cm</Height>
                              <Style>
                                <BackgroundColor>#CCCCCC</BackgroundColor>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                              </Style>
                            </Rectangle>
                            <!-- Invoice meta - right side -->
                            <Textbox Name="tbInvNoLbl">
                              <CanGrow>false</CanGrow>
                              <Top>0cm</Top>
                              <Left>11.3cm</Left>
                              <Width>3.8cm</Width>
                              <Height>0.55cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
