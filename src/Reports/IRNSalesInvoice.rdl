                                <Paragraph>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!No_.Value, "HeaderGroup")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>#222222</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbInvDateLbl">
                              <CanGrow>false</CanGrow>
                              <Top>0.65cm</Top>
                              <Left>11.3cm</Left>
                              <Width>3.8cm</Width>
                              <Height>0.55cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Invoice Date</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>8pt</FontSize>
                                        <Color>#777777</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbInvDateVal">
                              <CanGrow>false</CanGrow>
                              <Top>0.65cm</Top>
                              <Left>15.2cm</Left>
                              <Width>3.8cm</Width>
                              <Height>0.55cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Format(First(Fields!Posting_Date.Value, "HeaderGroup"), "dd MMM yyyy")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <Color>#222222</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbDueDateLbl">
                              <CanGrow>false</CanGrow>
                              <Top>1.3cm</Top>
                              <Left>11.3cm</Left>
                              <Width>3.8cm</Width>
                              <Height>0.55cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Due Date</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>8pt</FontSize>
                                        <Color>#777777</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbDueDateVal">
                              <CanGrow>false</CanGrow>
                              <Top>1.3cm</Top>
                              <Left>15.2cm</Left>
                              <Width>3.8cm</Width>
                              <Height>0.55cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Format(First(Fields!Due_Date.Value, "HeaderGroup"), "dd MMM yyyy")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <Color>#222222</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbExtDocLbl">
                              <CanGrow>false</CanGrow>
                              <Top>1.95cm</Top>
                              <Left>11.3cm</Left>
                              <Width>3.8cm</Width>
                              <Height>0.55cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Reference No.</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>8pt</FontSize>
                                        <Color>#777777</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbExtDocVal">
                              <CanGrow>false</CanGrow>
                              <Top>1.95cm</Top>
                              <Left>15.2cm</Left>
                              <Width>3.8cm</Width>
                              <Height>0.55cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!External_Document_No_.Value, "HeaderGroup")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
