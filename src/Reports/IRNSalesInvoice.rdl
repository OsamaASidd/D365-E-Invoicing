<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:DataSourceID>71481647-e498-4060-b498-964a2c498e72</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Tablix Name="InvoiceTablix">
            <TablixBody>
              <TablixColumns>
                <TablixColumn>
                  <Width>19cm</Width>
                </TablixColumn>
              </TablixColumns>
              <TablixRows>
                <!-- ROW 1: COMPANY HEADER (5.5cm) -->
                <TablixRow>
                  <Height>5.5cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="HeaderRect">
                          <Width>19cm</Width>
                          <Height>5.5cm</Height>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                          </Style>
                          <ReportItems>
                            <Textbox Name="tbCompanyName">
                              <CanGrow>true</CanGrow>
                              <Top>0cm</Top>
                              <Left>0cm</Left>
                              <Width>11.5cm</Width>
                              <Height>0.65cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!CompanyName.Value, "HeaderGroup")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>#1B2C6B</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbCompanyAddr">
                              <CanGrow>true</CanGrow>
                              <Top>0.7cm</Top>
                              <Left>0cm</Left>
                              <Width>11.5cm</Width>
                              <Height>0.5cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!CompanyAddress.Value, "HeaderGroup")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <Color>#444444</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbCompanyCity">
                              <CanGrow>true</CanGrow>
                              <Top>1.2cm</Top>
                              <Left>0cm</Left>
                              <Width>11.5cm</Width>
                              <Height>0.5cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!CompanyCity.Value, "HeaderGroup")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <Color>#444444</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbCompanyPhone">
                              <CanGrow>true</CanGrow>
                              <Top>1.7cm</Top>
                              <Left>0cm</Left>
                              <Width>11.5cm</Width>
                              <Height>0.5cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!CompanyPhone.Value, "HeaderGroup")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <Color>#444444</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbCompanyEmail">
                              <CanGrow>true</CanGrow>
                              <Top>2.2cm</Top>
                              <Left>0cm</Left>
                              <Width>11.5cm</Width>
                              <Height>0.5cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!CompanyEmail.Value, "HeaderGroup")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <Color>#444444</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <Textbox Name="tbCompanyVAT">
                              <CanGrow>true</CanGrow>
                              <Top>2.7cm</Top>
                              <Left>0cm</Left>
                              <Width>11.5cm</Width>
                              <Height>0.5cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="VAT Reg: " &amp; First(Fields!CompanyVATRegNo.Value, "HeaderGroup")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>8.5pt</FontSize>
                                        <Color>#444444</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                            <!-- Logo box with navy border, top-right -->
                            <Rectangle Name="LogoBorderBox">
                              <Top>0cm</Top>
                              <Left>12.5cm</Left>
                              <Width>6.5cm</Width>
                              <Height>3.4cm</Height>
                              <Style>
                                <Border>
                                  <Style>Solid</Style>
                                  <Color>#1B2C6B</Color>
                                  <Width>1.5pt</Width>
                                </Border>
                              </Style>
                              <ReportItems>
                                <Image Name="CompanyLogo">
                                  <Source>Database</Source>
                                  <Value>=First(Fields!CompanyPicture.Value, "HeaderGroup")</Value>
                                  <MIMEType>image/png</MIMEType>
                                  <Sizing>FitProportional</Sizing>
                                  <Top>0.15cm</Top>
                                  <Left>0.15cm</Left>
                                  <Width>6.2cm</Width>
                                  <Height>3.1cm</Height>
                                </Image>
                              </ReportItems>
                            </Rectangle>
                            <!-- Navy separator line -->
                            <Rectangle Name="HeaderSep">
                              <Top>3.7cm</Top>
                              <Left>0cm</Left>
                              <Width>19cm</Width>
                              <Height>0.08cm</Height>
                              <Style>
                                <BackgroundColor>#1B2C6B</BackgroundColor>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                              </Style>
                            </Rectangle>
                            <!-- SALES INVOICE title -->
                            <Textbox Name="tbInvoiceTitle">
                              <CanGrow>false</CanGrow>
                              <Top>3.9cm</Top>
                              <Left>0cm</Left>
                              <Width>19cm</Width>
                              <Height>1.4cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>SALES INVOICE</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>22pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>#1B2C6B</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
