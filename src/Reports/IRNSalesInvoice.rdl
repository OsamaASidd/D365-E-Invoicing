                              <Style>None</Style>
                            </Border>
                          </Style>
                          <ReportItems>
                            <Textbox Name="tbBillToLabel">
                              <CanGrow>false</CanGrow>
                              <Top>0cm</Top>
                              <Left>0cm</Left>
                              <Width>5cm</Width>
                              <Height>0.55cm</Height>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>BILL TO</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>7.5pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>#1B2C6B</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
